@{
    Layout = null;
}
@model CNHSworkloadAndClassSchedulingSystem.Models.ViewModels.LoginViewModel
<link rel="stylesheet" href="~/css/site.css" />
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

<div class="banner">
    <h2 class="banner-title">CORELLA NATIONAL HIGH SCHOOL</h2>
</div>

<div class="container">

    <div class="row justify-content-center align-items-center g-5">

        <div class="col-md-6 text-center">
            <img src="~/images/logo.png" alt="Corella NHS Logo" class="school-logo" />
            <p class="mt-3 fw-bold">WELCOME TO THE CORELLA NATIONAL HIGH SCHOOL CLASS SCHEDULER</p>
        </div>

        <div class="col-md-6">
            <div class="login-card mt-5">
                <form asp-action="LogIn" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <h3 class="mb-3 fw-normal text-center">Please Sign In</h3>

                    <div class="form-floating mb-3">
                        <input asp-for="Username" type="text" class="form-control" id="floatingUser" placeholder="Username" required />
                        <label for="floatingUser">User Name</label>
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Password" type="password" class="form-control" id="floatingPassword" placeholder="Password" required />
                        <label for="floatingPassword">Password</label>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-check text-start my-3">
                        <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="checkDefault" />
                        <label class="form-check-label" for="checkDefault">Remember me</label>
                    </div>

                    <button class="btn btn-primary w-100 py-2" type="submit">Sign in</button>

                    <p class="mt-5 mb-3 text-body-secondary text-center">© Corella NHS 2026</p>
                </form>
            </div>
        </div>
    </div>
</div>
