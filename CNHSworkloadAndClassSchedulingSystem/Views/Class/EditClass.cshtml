@model CNHSworkloadAndClassSchedulingSystem.Models.ViewModels.ClassViewModel

@{
    ViewData["Title"] = "Edit Class";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header">
            <h4 class="mb-0">Edit Class Section</h4>
        </div>

        <div class="card-body">

            <form asp-controller="Class"
                  asp-action="EditClass"
                  method="post">
                  <input type="hidden" asp-for="ClassSectionID" />

                <input type="hidden" asp-for="SchoolYearID" />

                <div class="mb-3">
                    <label asp-for="Department"
                           class="form-label">Department</label>

                    <select asp-for="Department"
                            asp-items="Model.Departments"
                            class="form-select">
                        <option value="">Select Department</option>
                    </select>

                    <span asp-validation-for="Department"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="GradeLevel"
                           class="form-label">Grade Level</label>

                    <select asp-for="GradeLevel"
                            asp-items="Model.GradeLevels"
                            class="form-select">
                        <option value="">Select Grade Level</option>
                    </select>

                    <span asp-validation-for="GradeLevel"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SectionName"
                           class="form-label">Section Name</label>

                    <input asp-for="SectionName"
                           class="form-control"
                           placeholder="Enter section name" />

                    <span asp-validation-for="SectionName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="AdviserID"
                           class="form-label">Adviser</label>

                    <select asp-for="AdviserID"
                            asp-items="Model.Advisers"
                            class="form-select">
                        <option value="">No Adviser Assigned Yet</option>
                    </select>

                    <span asp-validation-for="AdviserID"
                          class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-controller="Class"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Back
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Update Class
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}