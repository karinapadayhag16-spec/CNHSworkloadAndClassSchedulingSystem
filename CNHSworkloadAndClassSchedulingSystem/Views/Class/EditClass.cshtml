@model CNHSworkloadAndClassSchedulingSystem.Models.ViewModels.ClassViewModel

@{
    ViewData["Title"] = "Edit Class";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-11">
            <div class="card shadow-lg border-0">

                <div class="card-header bg-primary">
                    <h3 class="mb-0 fw-bold text-white">
                        <i class="bi bi-pencil-square"></i>
                        Edit Class
                    </h3>
                </div>

                <div class="card-body p-4">

                    <form asp-controller="Class"
                          asp-action="EditClass"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="ClassSectionID" />
                        <input type="hidden" asp-for="SchoolYearID" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <!-- DEPARTMENT AND GRADE LEVEL -->
                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label asp-for="Department"
                                       class="form-label fw-bold">
                                    Department
                                </label>

                                <select asp-for="Department"
                                        asp-items="Model.Departments"
                                        class="form-select">
                                    <option value="">Select Department</option>
                                </select>

                                <span asp-validation-for="Department"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="GradeLevel"
                                       class="form-label fw-bold">
                                    Grade Level
                                </label>

                                <select asp-for="GradeLevel"
                                        asp-items="Model.GradeLevels"
                                        class="form-select">
                                    <option value="">Select Grade Level</option>
                                </select>

                                <span asp-validation-for="GradeLevel"
                                      class="text-danger"></span>
                            </div>

                        </div>

                        <!-- SECTION NAME AND ADVISER -->
                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label asp-for="SectionName"
                                       class="form-label fw-bold">
                                    Section Name
                                </label>

                                <input asp-for="SectionName"
                                       class="form-control"
                                       placeholder="Enter section name" />

                                <span asp-validation-for="SectionName"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="AdviserID"
                                       class="form-label fw-bold">
                                    Adviser
                                </label>

                                <select asp-for="AdviserID"
                                        asp-items="Model.Advisers"
                                        class="form-select">
                                    <option value="">
                                        No Adviser Assigned Yet
                                    </option>
                                </select>

                                <span asp-validation-for="AdviserID"
                                      class="text-danger"></span>
                            </div>

                        </div>

                        <hr class="my-4" />

                        <!-- BUTTONS -->
                        <div class="d-flex justify-content-end gap-2">

                            <a asp-controller="Class"
                               asp-action="Index"
                               class="btn btn-secondary">
                                <i class="bi bi-arrow-left-circle"></i>
                                Back
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                <i class="bi bi-save"></i>
                                Update Class
                            </button>

                        </div>

                    </form>

                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}