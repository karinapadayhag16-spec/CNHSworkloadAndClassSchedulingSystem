@{
}
@{
    ViewData["Title"] = "Classes";
}

<div class="container-fluid mt-4">
    <h3 class="fw-bold mb-4">
        <i class="bi bi-people me-2"></i> Classes
    </h3>

    <div class="d-flex mb-3">
        <button class="btn btn-primary fw-bold me-2">
            <i class="bi bi-plus-circle me-2"></i> Add Class +
        </button>

        <div class="dropdown me-2">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                Grade Lvl
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="#">7</a></li>
                <li><a class="dropdown-item" href="#">8</a></li>
                <li><a class="dropdown-item" href="#">9</a></li>
                <li><a class="dropdown-item" href="#">10</a></li>
                <li><a class="dropdown-item" href="#">11</a></li>
                <li><a class="dropdown-item" href="#">12</a></li>
            </ul>
        </div>

        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                Section
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="#">Section A</a></li>
                <li><a class="dropdown-item" href="#">Section B</a></li>
            </ul>
        </div>
    </div>

    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Department</th>
                <th>Grade Lvl</th>
                <th>Section</th>
                <th>Adviser</th>
                <th style="width:150px;">Action</th>
            </tr>
        </thead>
    </table>
</div>
