@{
    ViewData["Title"] = "Documentation";
}

<div class="container mt-4">

    <div class="card shadow-lg border-0">

        <div class="card-header bg-primary">

            <h3 class="mb-0 fw-bold text-white">

                <i class="bi bi-file-earmark-text"></i>
                System Documentation

            </h3>

        </div>

        <div class="card-body">

            <div class="row align-items-center">

                <!-- Left Image -->
                <div class="col-md-5 text-center">

                    <img src="~/images/documentation-placeholder.png"
                         class="img-fluid rounded shadow"
                         alt="Documentation Image"
                         style="max-height:400px;" />

                </div>

                <!-- Right Instruction -->
                <div class="col-md-7">

                    <h4 class="fw-bold mb-3">
                        How to Use the System
                    </h4>

                    <ol class="fs-5">

                        <li class="mb-3">
                            Set the Active School Year.
                        </li>

                        <li class="mb-3">
                            Configure Terms for the selected school year.
                        </li>

                        <li class="mb-3">
                            Add Teachers and assign their expertise.
                        </li>

                        <li class="mb-3">
                            Assign Ancillary Duties when necessary.
                        </li>

                        <li class="mb-3">
                            Create Class Sections.
                        </li>

                        <li class="mb-3">
                            Add Subjects and Subject Offerings.
                        </li>

                        <li class="mb-3">
                            Generate Faculty Workload Schedules.
                        </li>

                        <li class="mb-3">
                            Review and finalize generated schedules.
                        </li>

                    </ol>

                </div>

            </div>

        </div>

    </div>

</div>