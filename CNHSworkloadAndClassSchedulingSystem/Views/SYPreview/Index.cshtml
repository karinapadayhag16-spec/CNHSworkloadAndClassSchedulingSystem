@{
    ViewData["Title"] = "School Year";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold">School Year Management</h2>

        <button class="btn btn-success"
                data-bs-toggle="modal"
                data-bs-target="#addSYModal">
            + Add School Year
        </button>
    </div>

    <table class="table table-bordered table-hover text-center">
        <thead class="table-dark">
            <tr>
                <th>School Year</th>
                <th>Status</th>
                <th width="300">Actions</th>
            </tr>
        </thead>

        <tbody id="syTable"></tbody>

    </table>

</div>


<!-- ADD MODAL -->
<div class="modal fade" id="addSYModal">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Add School Year</h5>

                <button class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <label class="form-label">
                    School Year
                </label>

                <input type="text"
                       id="syInput"
                       class="form-control"
                       placeholder="2026-2027">

            </div>

            <div class="modal-footer">

                <button class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button class="btn btn-success"
                        onclick="addSY()">
                    Save
                </button>

            </div>

        </div>

    </div>

</div>


<!-- EDIT MODAL -->
<div class="modal fade" id="editSYModal">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">
                <h5>Edit School Year</h5>

                <button class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="editRowIndex">

                <label class="form-label">
                    School Year
                </label>

                <input type="text"
                       id="editSYInput"
                       class="form-control">

            </div>

            <div class="modal-footer">

                <button class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button class="btn btn-primary"
                        onclick="updateSY()">
                    Update
                </button>

            </div>

        </div>

    </div>

</div>


<script>

    function addSY() {

        let year = document.getElementById("syInput").value.trim();

        let pattern = /^\d{4}-\d{4}$/;

        if (!pattern.test(year)) {
            alert("Format should be YYYY-YYYY");
            return;
        }

        let row = `
            <tr>
                <td>${year}</td>

                <td>
                    <span class="badge bg-success">
                        Current
                    </span>
                </td>

                <td>

                    <button class="btn btn-warning btn-sm"
                            onclick="editSY(this)">
                        Edit
                    </button>

                    <button class="btn btn-danger btn-sm"
                            onclick="deleteSY(this)">
                        Delete
                    </button>

                    <button class="btn btn-info btn-sm text-white"
                            onclick="viewSY(this)">
                        View
                    </button>

                </td>
            </tr>`;

        document.getElementById("syTable").innerHTML += row;

        document.getElementById("syInput").value = "";

        bootstrap.Modal
            .getInstance(document.getElementById("addSYModal"))
            .hide();
    }


    function editSY(button) {

        let row = button.closest("tr");

        document.getElementById("editRowIndex").value =
            row.rowIndex;

        document.getElementById("editSYInput").value =
            row.cells[0].innerText;

        new bootstrap.Modal(
            document.getElementById("editSYModal")
        ).show();
    }


    function updateSY() {

        let index =
            document.getElementById("editRowIndex").value;

        let value =
            document.getElementById("editSYInput").value;

        let table =
            document.getElementById("syTable");

        table.rows[index - 1].cells[0].innerText = value;

        bootstrap.Modal
            .getInstance(document.getElementById("editSYModal"))
            .hide();
    }


    function deleteSY(button) {

        if (confirm("Delete this School Year?")) {

            button.closest("tr").remove();

        }
    }


    function viewSY(button) {

        let row = button.closest("tr");

        let sy = row.cells[0].innerText;
        let status = row.cells[1].innerText;

        alert(
            "School Year: " + sy +
            "\nStatus: " + status
        );
    }

</script>
