@{
}
@{
    ViewData["Title"] = "Schedule";
}

<div class="container-fluid mt-4">
    <h3 class="fw-bold mb-4">
        <i class="bi bi-calendar-check me-2"></i> Schedule
    </h3>

    <div class="d-flex align-items-center mb-3">
        <button class="btn btn-outline-primary fw-bold me-2">Class</button>
        <button class="btn btn-outline-secondary fw-bold me-3">Teacher</button>

        <div class="dropdown me-2">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                Department
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="#">JHS</a></li>
                <li><a class="dropdown-item" href="#">SHS</a></li>
            </ul>
        </div>

        <div class="dropdown me-2">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                Grade Lvl
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="#">7</a></li>
                <li><a class="dropdown-item" href="#">8</a></li>
                <li><a class="dropdown-item" href="#">9</a></li>
                <li><a class="dropdown-item" href="#">10</a></li>
                <li><a class="dropdown-item" href="#">11</a></li>
                <li><a class="dropdown-item" href="#">12</a></li>
            </ul>
        </div>

        <div class="dropdown me-3">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                Section
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="#">Section A</a></li>
                <li><a class="dropdown-item" href="#">Section B</a></li>
            </ul>
        </div>

        <button class="btn btn-primary fw-bold">Set Schedule +</button>
    </div>

    <table class="table table-bordered text-center align-middle">
        <thead class="table-dark">
            <tr>
                <th>Time</th>
                <th>Monday</th>
                <th>Tuesday</th>
                <th>Wednesday</th>
                <th>Thursday</th>
                <th>Friday</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
            <tr>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
            <tr>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
        </tbody>
    </table>

    <div class="mt-3 text-end">
        <button class="btn btn-secondary fw-bold">Print</button>
    </div>
</div>
