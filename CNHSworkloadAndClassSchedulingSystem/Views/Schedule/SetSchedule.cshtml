```cshtml
@{
    ViewData["Title"] = "Set Schedule";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-11">

            <div class="card shadow-lg border-0">

                <div class="card-header bg-primary">
                    <h3 class="mb-0 fw-bold text-white">
                        <i class="bi bi-calendar-check me-2"></i>
                        Set Schedule
                    </h3>
                </div>

                <div class="card-body p-4">

                    <form method="post">

                        <!-- School Year and Department -->
                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">School Year</label>
                                <select name="SchoolYearID" class="form-select" required>
                                    <option value="">Select School Year</option>
                                    @* Populate school years from the controller *@
                                </select>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Department</label>
                                <select name="Department" id="department"
                                        class="form-select" required>
                                    <option value="">Select Department</option>
                                    <option value="JHS">Junior High School</option>
                                    <option value="SHS">Senior High School</option>
                                </select>
                            </div>

                        </div>

                        <!-- Grade Level and Section -->
                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Grade Level</label>
                                <select name="GradeLevel" id="gradeLevel"
                                        class="form-select" required>
                                    <option value="">Select Grade Level</option>
                                </select>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Section</label>
                                <select name="ClassSectionID" class="form-select" required>
                                    <option value="">Select Section</option>
                                    @* Populate sections from the controller *@
                                </select>
                            </div>

                        </div>

                        <!-- Subject and Teacher -->
                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Subject</label>
                                <select name="SubjectID" class="form-select" required>
                                    <option value="">Select Subject</option>
                                    @* Populate subjects from the controller *@
                                </select>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Teacher</label>
                                <select name="TeacherID" class="form-select" required>
                                    <option value="">Select Teacher</option>
                                    @* Populate teachers from the controller *@
                                </select>
                            </div>

                        </div>

                        <hr />

                        <!-- Days -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Schedule Days</label>

                            <div class="row">

                                <div class="col-md-2 col-4 mb-2">
                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="checkbox" name="Days"
                                               value="Monday" id="monday">
                                        <label class="form-check-label" for="monday">
                                            Monday
                                        </label>
                                    </div>
                                </div>

                                <div class="col-md-2 col-4 mb-2">
                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="checkbox" name="Days"
                                               value="Tuesday" id="tuesday">
                                        <label class="form-check-label" for="tuesday">
                                            Tuesday
                                        </label>
                                    </div>
                                </div>

                                <div class="col-md-2 col-4 mb-2">
                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="checkbox" name="Days"
                                               value="Wednesday" id="wednesday">
                                        <label class="form-check-label" for="wednesday">
                                            Wednesday
                                        </label>
                                    </div>
                                </div>

                                <div class="col-md-2 col-4 mb-2">
                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="checkbox" name="Days"
                                               value="Thursday" id="thursday">
                                        <label class="form-check-label" for="thursday">
                                            Thursday
                                        </label>
                                    </div>
                                </div>

                                <div class="col-md-2 col-4 mb-2">
                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="checkbox" name="Days"
                                               value="Friday" id="friday">
                                        <label class="form-check-label" for="friday">
                                            Friday
                                        </label>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <hr />

                        <!-- Time -->
                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Start Time</label>
                                <input type="time" name="StartTime"
                                       class="form-control" required />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">End Time</label>
                                <input type="time" name="EndTime"
                                       class="form-control" required />
                            </div>

                        </div>

                        <!-- Buttons -->
                        <div class="text-end mt-4">

                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-save me-1"></i>
                                Save Schedule
                            </button>

                            <a asp-controller="Schedule"
                               asp-action="Index"
                               class="btn btn-secondary">
                                <i class="bi bi-arrow-left me-1"></i>
                                Back
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Filter grade levels according to department
        document.getElementById("department").addEventListener("change", function() {

            const department = this.value;
            const gradeLevel = document.getElementById("gradeLevel");

            gradeLevel.innerHTML = '<option value="">Select Grade Level</option>';

            let grades = [];

            if (department === "JHS") {
                grades = [7, 8, 9, 10];
            }
            else if (department === "SHS") {
                grades = [11, 12];
            }

            grades.forEach(function(grade) {
                const option = document.createElement("option");
                option.value = grade;
                option.textContent = "Grade " + grade;
                gradeLevel.appendChild(option);
            });
        });
    </script>
}
```