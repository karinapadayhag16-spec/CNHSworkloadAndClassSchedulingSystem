@model CNHSworkloadAndClassSchedulingSystem.Models.ViewModels.AddSchoolYearViewModel

@{
    ViewData["Title"] = "Edit School Year";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-lg border-0">

                <div class="card-header bg-warning">
                    <h3 class="mb-0 fw-bold text-dark">
                        <i class="bi bi-pencil-square"></i>
                        Edit School Year
                    </h3>
                </div>

                <div class="card-body p-4">

                    <form asp-action="EditSchoolYear"
                          asp-route-id="@ViewBag.SchoolYearId"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label asp-for="StartYear" class="form-label">
                                Start Year
                            </label>

                            <input asp-for="StartYear"
                                   class="form-control"
                                   style="width:70%;"
                                   data-bs-toggle="tooltip"
                                   data-bs-placement="right"
                                   title="Enter the starting year of the School Year" />

                            <span asp-validation-for="StartYear"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="EndYear" class="form-label">
                                End Year
                            </label>

                            <input asp-for="EndYear"
                                   class="form-control"
                                   style="width:70%;"
                                   data-bs-toggle="tooltip"
                                   data-bs-placement="right"
                                   title="Enter the ending year of the School Year" />

                            <span asp-validation-for="EndYear"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="form-check mb-4">

                            <input asp-for="IsCurrent"
                                   class="form-check-input"
                                   id="currentSchoolYear"
                                   data-bs-toggle="tooltip"
                                   data-bs-placement="right"
                                   title="Set this School Year as the active School Year" />

                            <label asp-for="IsCurrent"
                                   class="form-check-label">
                                Current School Year
                            </label>

                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-success"
                                    data-bs-toggle="tooltip"
                                    data-bs-placement="top"
                                    title="Save the changes made to this School Year">

                                <i class="bi bi-save"></i>
                                Save Changes

                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary"
                               data-bs-toggle="tooltip"
                               data-bs-placement="top"
                               title="Return to the School Year list">

                                <i class="bi bi-arrow-left-circle"></i>
                                Back

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

<!-- Warning Modal -->
<div class="modal fade"
     id="currentSchoolYearModal"
     tabindex="-1"
     aria-labelledby="currentSchoolYearModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-danger">

            <div class="modal-header bg-danger text-white">

                <h5 class="modal-title"
                    id="currentSchoolYearModalLabel">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    Warning
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <div class="alert alert-danger mb-0">

                    <h6 class="fw-bold">
                        Are you sure?
                    </h6>

                    <p class="mb-2">
                        You are about to set this School Year as the
                        <strong>Current School Year.</strong>
                    </p>

                    <p class="mb-0">
                        This action will automatically remove the Current status
                        from any other School Year that is currently active.
                    </p>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-danger"
                        id="confirmCurrentSchoolYear">

                    <i class="bi bi-check-circle"></i>
                    Yes, Set as Current

                </button>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            // Enable Tooltips
            var tooltipTriggerList =
                [].slice.call(
                    document.querySelectorAll('[data-bs-toggle="tooltip"]')
                );

            tooltipTriggerList.forEach(function(tooltipTriggerEl) {

                new bootstrap.Tooltip(tooltipTriggerEl);

            });

            // Current School Year Modal
            const checkbox =
                document.getElementById("currentSchoolYear");

            const modalElement =
                document.getElementById("currentSchoolYearModal");

            const confirmButton =
                document.getElementById("confirmCurrentSchoolYear");

            if (!checkbox || !modalElement || !confirmButton)
                return;

            const modal =
                new bootstrap.Modal(modalElement);

            let confirmed = false;

            checkbox.addEventListener("change", function() {

                if (checkbox.checked && !confirmed) {

                    checkbox.checked = false;

                    modal.show();

                }

            });

            confirmButton.addEventListener("click", function() {

                confirmed = true;

                checkbox.checked = true;

                modal.hide();

            });

        });

    </script>

}