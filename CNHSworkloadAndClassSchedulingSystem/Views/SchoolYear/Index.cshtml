
@using CNHSworkloadAndClassSchedulingSystem.Models.Enums
@model IEnumerable<CNHSworkloadAndClassSchedulingSystem.Models.Domain.SchoolYear>

@{
    ViewData["Title"] = "School Year";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2 class="fw-bold">
            School Year Management
        </h2>

        <a asp-controller="SchoolYear"
           asp-action="AddSchoolYear"
           class="btn btn-primary"
           data-bs-toggle="tooltip"
           data-bs-placement="top"
           title="Add a new School Year to the system">

            <i class="bi bi-plus-circle"></i>
            Add School Year

        </a>

    </div>

    <table class="table table-bordered table-hover text-center">

        <thead class="table-dark">

            <tr>
                <th width="80">#</th>
                <th>School Year</th>
                <th>Status</th>
                <th width="150">Actions</th>
            </tr>

        </thead>

        <tbody>

            @{
                int count = 1;
            }

            @if (Model != null && Model.Any())
            {
                @foreach (var schoolYear in Model)
                {
                    <tr>

                        <td>@count</td>

                        <td>@schoolYear.YearLabel</td>

                        <td>
                            @switch (schoolYear.Status)
                            {
                                case SchoolYearStatus.Setup:
                                    <span class="badge bg-secondary">
                                        Setup
                                    </span>
                                    break;

                                case SchoolYearStatus.Active:
                                    <span class="badge bg-success">
                                        Current
                                    </span>
                                    break;

                                case SchoolYearStatus.Completed:
                                    <span class="badge bg-primary">
                                        Completed
                                    </span>
                                    break;

                                default:
                                    <span class="badge bg-dark">
                                        Unknown
                                    </span>
                                    break;
                            }
                        </td>

                        <td>

                            <a asp-controller="SchoolYear"
                               asp-action="EditSchoolYear"
                               asp-route-id="@schoolYear.SchoolYearId"
                               class="btn btn-warning btn-sm"
                               data-bs-toggle="tooltip"
                               data-bs-placement="top"
                               title="Edit this School Year">

                                <i class="bi bi-pencil-square"></i>
                                Edit

                            </a>

                        </td>

                    </tr>

                    count++;
                }
            }
            else
            {
                <tr>

                    <td colspan="4"
                        class="text-muted py-4">

                        No school years have been added yet.

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>

@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            var tooltipTriggerList =
                [].slice.call(
                    document.querySelectorAll('[data-bs-toggle="tooltip"]')
                );

            tooltipTriggerList.forEach(function(tooltipTriggerEl) {

                new bootstrap.Tooltip(tooltipTriggerEl);

            });

        });

    </script>

}
