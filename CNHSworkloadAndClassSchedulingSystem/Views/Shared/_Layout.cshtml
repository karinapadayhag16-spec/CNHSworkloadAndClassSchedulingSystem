<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CNHSworkloadAndClassSchedulingSystem</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <header class="bg-maroon thin-border">
        <div class="d-flex align-items-center p-2">
            <img src="~/images/logo.png" alt="Corella NHS Logo" width="35" height="35" class="me-2" />
            <h5 class="text-white fw-bold mb-0">CORELLA NATIONAL HIGH SCHOOL</h5>
        </div>
    </header>

    <div class="d-flex">

        <nav class="sidebar bg-light border-end thin-border p-3" style="width:220px;">
            <ul class="nav flex-column">
                <li class="nav-item mb-2">
                    <a class="nav-link active fw-semibold" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link fw-semibold" asp-controller="SYPreview" asp-action="Index">S.Y Preview</a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link fw-semibold" asp-controller="TimeSched" asp-action="Index">Time Sched</a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link fw-semibold" asp-controller="Classes" asp-action="Index">Classes</a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link fw-semibold" asp-controller="Teachers" asp-action="Index">Teachers</a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link fw-semibold" asp-controller="Subjects" asp-action="Index">Subjects</a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link fw-semibold" asp-controller="UserSetting" asp-action="Index">User Setting</a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link fw-semibold" asp-controller="Schedule" asp-action="Index">Schedule</a>
                </li>
            </ul>
        </nav>

        <div class="flex-grow-1 p-4">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="border-top footer text-muted mt-4">
        <div class="container text-center">
            &copy; 2026 - CNHSworkloadAndClassSchedulingSystem
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
