<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CNHSworkloadAndClassSchedulingSystem</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
</head>
<body>

    <header class="bg-maroon thin-border"
            style="position:fixed; top:0; left:0; right:0; z-index:1030; height:60px;">
        <div class="d-flex align-items-center p-2">
            <img src="~/images/logo.png" alt="Corella NHS Logo" width="35" height="35" class="me-2" />
            <h5 class="text-white fw-bold mb-0">CORELLA NATIONAL HIGH SCHOOL</h5>
        </div>
    </header>

    <div class="d-flex" style="margin-top:60px;">
        <nav class="sidebar bg-light border-end thin-border d-flex flex-column"
             style="width:220px; height:calc(100vh - 60px); position:fixed; top:60px; left:0; overflow-y:auto; padding:20px 15px;">

            <ul class="nav flex-column flex-grow-1">
                <li class="nav-item mb-2">
                    <a class="nav-link active fw-semibold" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-speedometer2 me-2"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link fw-semibold" asp-controller="SYPreview" asp-action="Index">
                        <i class="bi bi-calendar3 me-2"></i> S.Y Preview
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link fw-semibold" asp-controller="TimeSched" asp-action="Index">
                        <i class="bi bi-clock me-2"></i> Time Sched
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link fw-semibold" asp-controller="Classes" asp-action="Index">
                        <i class="bi bi-people me-2"></i> Classes
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link fw-semibold" asp-controller="Teachers" asp-action="Index">
                        <i class="bi bi-person-badge me-2"></i> Teachers
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link fw-semibold" asp-controller="Subjects" asp-action="Index">
                        <i class="bi bi-book me-2"></i> Subjects
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link fw-semibold" asp-controller="UserSetting" asp-action="Index">
                        <i class="bi bi-gear me-2"></i> User Setting
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link fw-semibold" asp-controller="Schedule" asp-action="Index">
                        <i class="bi bi-calendar-check me-2"></i> Schedule
                    </a>
                </li>
            </ul>

            <div class="mb-xl-5">
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-danger w-100 fw-bold">
                        <i class="bi bi-box-arrow-right me-2"></i> Log Out
                    </button>
                </form>
            </div>
        </nav>

        <div class="flex-grow-1 p-4" style="margin-left:220px;">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="border-top footer text-muted p-3 text-center" style="margin-left:220px; margin-top:60px;">
        <div>
            &copy; 2026 - CNHSworkloadAndClassSchedulingSystem
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
