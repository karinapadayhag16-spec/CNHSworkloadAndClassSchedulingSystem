@{
}
@{
    ViewData["Title"] = "Add Subject";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-lg-11">

            <div class="card shadow-lg border-0">

                <div class="card-header bg-primary">

                    <h3 class="mb-0 fw-bold text-white">

                        <i class="bi bi-plus-circle"></i>
                        Add Subject

                    </h3>

                </div>

                <div class="card-body p-4">

                    <form>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label class="form-label fw-bold">
                                    Subject Name
                                </label>

                                <input type="text"
                                       class="form-control"
                                       placeholder="e.g. Mathematics"
                                       data-bs-toggle="tooltip"
                                       data-bs-placement="right"
                                       title="Enter the subject name" />

                            </div>

                            <div class="col-md-6 mb-3">

                                <label class="form-label fw-bold">
                                    Department
                                </label>

                                <select class="form-select"
                                        data-bs-toggle="tooltip"
                                        data-bs-placement="right"
                                        title="Select the department">

                                    <option>Select Department</option>

                                    <option>JHS</option>

                                    <option>SHS</option>

                                </select>

                            </div>

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label class="form-label fw-bold">
                                    Grade Level
                                </label>

                                <select class="form-select"
                                        data-bs-toggle="tooltip"
                                        data-bs-placement="right"
                                        title="Select the grade level">

                                    <option>Select Grade Level</option>

                                    <option>Grade 7</option>

                                    <option>Grade 8</option>

                                    <option>Grade 9</option>

                                    <option>Grade 10</option>

                                    <option>Grade 11</option>

                                    <option>Grade 12</option>

                                </select>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label class="form-label fw-bold">
                                    Number of Classes
                                </label>

                                <input type="number"
                                       class="form-control"
                                       placeholder="e.g. 3"
                                       data-bs-toggle="tooltip"
                                       data-bs-placement="right"
                                       title="Enter the number of class sections taking this subject" />

                            </div>

                        </div>

                        <hr />

                        <div class="text-end">

                            <button type="submit"
                                    class="btn btn-success"
                                    data-bs-toggle="tooltip"
                                    data-bs-placement="top"
                                    title="Save this subject">

                                <i class="bi bi-save"></i>
                                Save Subject

                            </button>

                            <a asp-controller="Subject"
                               asp-action="Index"
                               class="btn btn-secondary"
                               data-bs-toggle="tooltip"
                               data-bs-placement="top"
                               title="Return to subject list">

                                <i class="bi bi-arrow-left-circle"></i>
                                Back

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            var tooltipTriggerList =
                [].slice.call(
                    document.querySelectorAll('[data-bs-toggle="tooltip"]')
                );

            tooltipTriggerList.forEach(function(tooltipTriggerEl) {

                new bootstrap.Tooltip(tooltipTriggerEl);

            });

        });

    </script>

}