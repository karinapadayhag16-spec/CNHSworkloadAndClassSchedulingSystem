
@model CNHSworkloadAndClassSchedulingSystem.Models.ViewModels.TeacherViewModel

@{
    ViewData["Title"] = "Add Teacher";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-lg-11">

            <div class="card shadow-lg border-0">

                <div class="card-header bg-primary">

                    <h3 class="mb-0 fw-bold text-white">
                        <i class="bi bi-plus-circle"></i>
                        Add Teacher
                    </h3>

                </div>

                <div class="card-body p-4">

                    <form asp-controller="Teacher"
                          asp-action="AddTeacher"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="SchoolYearID" />

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                School Year
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@ViewBag.ActiveSchoolYear"
                                   readonly />

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="FirstName"
                                       class="form-label fw-bold">
                                    First Name
                                </label>

                                <input asp-for="FirstName"
                                       class="form-control"
                                       placeholder="Enter first name"
                                       data-bs-toggle="tooltip"
                                       data-bs-placement="right"
                                       title="Enter the teacher's first name" />

                                <span asp-validation-for="FirstName"
                                      class="text-danger"></span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="LastName"
                                       class="form-label fw-bold">
                                    Last Name
                                </label>

                                <input asp-for="LastName"
                                       class="form-control"
                                       placeholder="Enter last name"
                                       data-bs-toggle="tooltip"
                                       data-bs-placement="right"
                                       title="Enter the teacher's last name" />

                                <span asp-validation-for="LastName"
                                      class="text-danger"></span>

                            </div>

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="Department"
                                       class="form-label fw-bold">
                                    Department
                                </label>

                                <select asp-for="Department"
                                        asp-items="Model.Departments"
                                        class="form-select"
                                        data-bs-toggle="tooltip"
                                        data-bs-placement="right"
                                        title="Select the teacher's department">

                                    <option value="">Select Department</option>

                                </select>

                                <span asp-validation-for="Department"
                                      class="text-danger"></span>

                            </div>

                        </div>

                        <hr />

                        <div class="text-end">

                            <button type="submit"
                                    class="btn btn-success"
                                    data-bs-toggle="tooltip"
                                    data-bs-placement="top"
                                    title="Save this teacher">

                                <i class="bi bi-save"></i>
                                Save Teacher

                            </button>

                            <a asp-controller="Teacher"
                               asp-action="Index"
                               class="btn btn-secondary"
                               data-bs-toggle="tooltip"
                               data-bs-placement="top"
                               title="Return to the teacher list">

                                <i class="bi bi-arrow-left-circle"></i>
                                Back

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            var tooltipTriggerList =
                [].slice.call(
                    document.querySelectorAll('[data-bs-toggle="tooltip"]')
                );

            tooltipTriggerList.forEach(function(tooltipTriggerEl) {

                new bootstrap.Tooltip(tooltipTriggerEl);

            });

        });

    </script>

}
