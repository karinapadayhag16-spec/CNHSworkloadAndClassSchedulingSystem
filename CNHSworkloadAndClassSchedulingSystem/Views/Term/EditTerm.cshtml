@model CNHSworkloadAndClassSchedulingSystem.Models.ViewModels.AddTermViewModel

@{
    ViewData["Title"] = "Edit Term";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-lg border-0">

                <div class="card-header bg-warning">

                    <h3 class="mb-0 fw-bold text-dark">

                        <i class="bi bi-pencil-square"></i>
                        Edit Term

                    </h3>

                </div>

                <div class="card-body p-4">

                    <form asp-action="EditTerm"
                          asp-route-id="@ViewBag.TermID"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Current School Year
                            </label>

                            <input value="@Model.SchoolYearLabel"
                                   class="form-control"
                                   style="width:70%;"
                                   readonly
                                   data-bs-toggle="tooltip"
                                   data-bs-placement="right"
                                   title="Displays the current active School Year" />

                        </div>

                        <div class="mb-3">

                            <label asp-for="TermNumber"
                                   class="form-label">
                                Term Number
                            </label>

                            <input asp-for="TermNumber"
                                   class="form-control"
                                   style="width:70%;"
                                   readonly
                                   data-bs-toggle="tooltip"
                                   data-bs-placement="right"
                                   title="Displays the selected Term Number" />

                            <span asp-validation-for="TermNumber"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="InstructionalDays"
                                   class="form-label">
                                Instructional Days
                            </label>

                            <input asp-for="InstructionalDays"
                                   class="form-control"
                                   style="width:70%;"
                                   min="1"
                                   max="365"
                                   data-bs-toggle="tooltip"
                                   data-bs-placement="right"
                                   title="Enter the number of instructional days for this term" />

                            <span asp-validation-for="InstructionalDays"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-success"
                                    data-bs-toggle="tooltip"
                                    data-bs-placement="top"
                                    title="Save the changes made to this Term">

                                <i class="bi bi-check-circle"></i>
                                Update

                            </button>

                            <a asp-controller="Term"
                               asp-action="Index"
                               class="btn btn-secondary"
                               data-bs-toggle="tooltip"
                               data-bs-placement="top"
                               title="Return to the Term list">

                                <i class="bi bi-arrow-left-circle"></i>
                                Back

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            var tooltipTriggerList =
                [].slice.call(
                    document.querySelectorAll('[data-bs-toggle="tooltip"]')
                );

            tooltipTriggerList.forEach(function(tooltipTriggerEl) {

                new bootstrap.Tooltip(tooltipTriggerEl);

            });

        });

    </script>

}