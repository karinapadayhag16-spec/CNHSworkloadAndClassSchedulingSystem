@{
    ViewData["Title"] = "Term";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold">Term Management</h2>

        <!--Taronga ni, e delete ang mga modal sa ubos apil tong modal nga dili na gamiton sa school year-->
    <a asp-controller="Term"
       asp-action="AddTerm"
       class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add Term
    </a>

    </div>

    <table class="table table-bordered table-hover text-center">
        <thead class="table-dark">
            <tr>
                <th>Term</th>
                <th>Status</th>
                <th width="300">Actions</th>
            </tr>
        </thead>

        <tbody id="termTable"></tbody>

    </table>

</div>

<div class="modal fade" id="addTermModal">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Add Term</h5>

                <button class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <label class="form-label">
                    Select Term
                </label>

                <select id="termInput"
                        class="form-select">
                    <option value="">-- Select Term --</option>
                    <option>1st Term</option>
                    <option>2nd Term</option>
                    <option>3rd Term</option>
                    <option>4th Term</option>
                </select>

            </div>

            <div class="modal-footer">

                <button class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button class="btn btn-success"
                        onclick="addTerm()">
                    Save
                </button>

            </div>

        </div>

    </div>

</div>

<div class="modal fade" id="editTermModal">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">
                <h5>Edit Term</h5>

                <button class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="editRowIndex">

                <label class="form-label">
                    Select Term
                </label>

                <select id="editTermInput"
                        class="form-select">
                    <option>1st Term</option>
                    <option>2nd Term</option>
                    <option>3rd Term</option>
                    <option>4th Term</option>
                </select>

            </div>

            <div class="modal-footer">

                <button class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button class="btn btn-primary"
                        onclick="updateTerm()">
                    Update
                </button>

            </div>

        </div>

    </div>

</div>