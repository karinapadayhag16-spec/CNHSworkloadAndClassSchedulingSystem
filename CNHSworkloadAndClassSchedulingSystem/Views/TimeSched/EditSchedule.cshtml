@{
}
@{
    ViewData["Title"] = "Edit Schedule";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-lg-11">

            <div class="card shadow-lg border-0">

                <div class="card-header bg-warning">

                    <h3 class="mb-0 fw-bold text-dark">

                        <i class="bi bi-pencil-square"></i>
                        Edit Schedule

                    </h3>

                </div>

                <div class="card-body p-4">

                    <div class="mb-4">

                        <label class="form-label fw-bold">
                            Schedule Name
                        </label>

                        <input type="text"
                               class="form-control"
                               style="max-width:500px;"
                               value="Regular Schedule"
                               data-bs-toggle="tooltip"
                               data-bs-placement="right"
                               title="Edit the schedule name" />

                    </div>

                    <div id="scheduleRows">

                        <div class="row align-items-end mb-4 schedule-row">

                            <div class="col-md-1 text-center">

                                <label class="form-label d-block">&nbsp;</label>

                                <span class="fw-bold fs-5">
                                    1
                                </span>

                            </div>

                            <div class="col-md-5">

                                <label class="form-label fw-semibold">
                                    Start Time
                                </label>

                                <div class="d-flex gap-2">

                                    <select class="form-select start-hour"
                                            data-bs-toggle="tooltip"
                                            title="Select start hour">

                                        <option selected>08</option>
                                        @for (int i = 1; i <= 12; i++)
                                        {
                                            if (i != 8)
                                            {
                                                <option>@i.ToString("00")</option>
                                            }
                                        }

                                    </select>

                                    <select class="form-select start-minute"
                                            data-bs-toggle="tooltip"
                                            title="Select start minute">

                                        @for (int i = 0; i < 60; i += 5)
                                        {
                                            <option selected="@(i == 0)">
                                                @i.ToString("00")
                                            </option>
                                        }

                                    </select>

                                    <select class="form-select start-period"
                                            data-bs-toggle="tooltip"
                                            title="Select start period">

                                        <option selected>AM</option>
                                        <option>PM</option>

                                    </select>

                                </div>

                            </div>

                            <div class="col-md-5">

                                <label class="form-label fw-semibold">
                                    End Time
                                </label>

                                <div class="d-flex gap-2">

                                    <select class="form-select end-hour"
                                            data-bs-toggle="tooltip"
                                            title="Select end hour">

                                        <option selected>09</option>
                                        @for (int i = 1; i <= 12; i++)
                                        {
                                            if (i != 9)
                                            {
                                                <option>@i.ToString("00")</option>
                                            }
                                        }

                                    </select>

                                    <select class="form-select end-minute"
                                            data-bs-toggle="tooltip"
                                            title="Select end minute">

                                        @for (int i = 0; i < 60; i += 5)
                                        {
                                            if (i == 0)
                                            {
                                                <option selected>
                                                    @i.ToString("00")
                                                </option>
                                            }
                                            else
                                            {
                                                <option>
                                                    @i.ToString("00")
                                                </option>
                                            }
                                        }
                                    </select>

                                    <select class="form-select end-period"
                                            data-bs-toggle="tooltip"
                                            title="Select end period">

                                        <option selected>AM</option>
                                        <option>PM</option>

                                    </select>

                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="text-end mb-3">

                        <button type="button"
                                id="addRow"
                                class="btn btn-primary"
                                data-bs-toggle="tooltip"
                                data-bs-placement="left"
                                title="Add another schedule period">

                            <i class="bi bi-plus-circle"></i>
                            Add Period

                        </button>


                    </div>

                    <hr />

                    <div class="text-end">

                        <button type="submit"
                                class="btn btn-warning"
                                data-bs-toggle="tooltip"
                                data-bs-placement="left"
                                title="Update this schedule">

                            <i class="bi bi-check-circle"></i>
                            Update Schedule

                        </button>

                        <a asp-controller="TimeSched"
                           asp-action="Index"
                           class="btn btn-secondary"
                           data-bs-toggle="tooltip"
                           data-bs-placement="top"
                           title="Return to the Term list">

                            <i class="bi bi-arrow-left-circle"></i>
                            Back
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

<script>

document.addEventListener("DOMContentLoaded", function () {

    var tooltipTriggerList =
        [].slice.call(
            document.querySelectorAll('[data-bs-toggle="tooltip"]')
        );

    tooltipTriggerList.forEach(function (tooltipTriggerEl) {

        new bootstrap.Tooltip(tooltipTriggerEl);

    });

});

</script>

}