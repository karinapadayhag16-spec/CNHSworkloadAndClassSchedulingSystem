@model IEnumerable<CNHSworkloadAndClassSchedulingSystem.Models.Domain.ApplicationUser>

@{
    ViewData["Title"] = "User Setting";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2 class="fw-bold">
            User Setting Management
        </h2>

        <div class="d-flex gap-2">

            <a asp-controller="UserSetting"
               asp-action="AddUsers"
               class="btn btn-primary"
               data-bs-toggle="tooltip"
               data-bs-placement="top"
               title="Add a new User">

                <i class="bi bi-plus-circle"></i>
                Add User

            </a>

        </div>

    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @successMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <table class="table table-bordered table-hover text-center">

        <thead class="table-dark">

            <tr>
                <th width="60">#</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Username</th>
                <th width="120">Status</th>
                <th width="320">Actions</th>
            </tr>

        </thead>

        <tbody>

            @{
                int count = 1;
            }

            @if (Model != null && Model.Any())
            {
                @foreach (var user in Model)
                {
                    <tr>

                        <td>@count</td>

                        <td class="fw-semibold">
                            @user.FirstName
                        </td>

                        <td class="fw-semibold">
                            @user.LastName
                        </td>

                        <td>
                            @user.UserName
                        </td>

                        <td>

                            @if (user.IsActive)
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Inactive
                                </span>
                            }

                        </td>

                        <td style="white-space: nowrap;">

                            <div class="d-flex justify-content-center align-items-center gap-2 flex-nowrap">

                                <!-- VIEW -->
                                <a asp-controller="UserSetting"
                                   asp-action="ViewUser"
                                   asp-route-id="@user.Id"
                                   class="btn btn-info btn-sm text-white"
                                   data-bs-toggle="tooltip"
                                   data-bs-placement="top"
                                   title="View user details">

                                    <i class="bi bi-eye"></i>
                                    View

                                </a>

                                <!-- EDIT -->
                                <a asp-controller="UserSetting"
                                   asp-action="EditUser"
                                   asp-route-id="@user.Id"
                                   class="btn btn-warning btn-sm"
                                   data-bs-toggle="tooltip"
                                   data-bs-placement="top"
                                   title="Edit user information">

                                    <i class="bi bi-pencil-square"></i>
                                    Edit

                                </a>

                                <!-- DELETE -->
                                <form asp-controller="UserSetting"
                                      asp-action="DeleteUser"
                                      asp-route-id="@user.Id"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete this user?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-danger btn-sm"
                                            data-bs-toggle="tooltip"
                                            data-bs-placement="top"
                                            title="Delete this user">

                                        <i class="bi bi-trash"></i>
                                        Delete

                                    </button>

                                </form>

                            </div>

                        </td>

                    </tr>

                    count++;
                }
            }
            else
            {
                <tr>

                    <td colspan="6" class="text-muted py-4">

                        No users have been registered yet.

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>

@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            var tooltipTriggerList =
                [].slice.call(
                    document.querySelectorAll('[data-bs-toggle="tooltip"]')
                );

            tooltipTriggerList.forEach(function(tooltipTriggerEl) {

                new bootstrap.Tooltip(tooltipTriggerEl);

            });

        });

    </script>

}
