
@model IEnumerable<CNHSworkloadAndClassSchedulingSystem.Models.Domain.TimeSchedule>

@{
    ViewData["Title"] = "Time Schedule";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2 class="fw-bold">
            Time Schedule Management
        </h2>

        <a asp-controller="TimeSched"
           asp-action="AddSchedule"
           class="btn btn-primary"
           data-bs-toggle="tooltip"
           data-bs-placement="top"
           title="Add a new Time Schedule">

            <i class="bi bi-plus-circle"></i>
            Add Time Schedule

        </a>

    </div>

    <table class="table table-bordered table-hover text-center">

        <thead class="table-dark">

            <tr>
                <th width="60">#</th>
                <th>Schedule Name</th>
                <th width="100">Version</th>
                <th width="130">Number of Periods</th>
                <th width="120">Status</th>
                <th width="250">Actions</th>
            </tr>

        </thead>

        <tbody>

            @{
                int count = 1;
            }

            @if (Model != null && Model.Any())
            {
                @foreach (var schedule in Model)
                {
                    <tr>

                        <td>@count</td>

                        <td class="fw-semibold">
                            @schedule.ScheduleName
                        </td>

                        <td>
                            Version @schedule.VersionNumber
                        </td>

                        <td>
                            @schedule.TimePeriods.Count
                        </td>

                        <td>
                            @if (schedule.IsArchived)
                            {
                                <span class="badge bg-secondary">
                                    Archived
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    Available
                                </span>
                            }
                        </td>

                        <td>

                            <a asp-controller="TimeSched"
                               asp-action="ViewSchedule"
                               asp-route-id="@schedule.TimeScheduleId"
                               class="btn btn-info btn-sm me-1"
                               data-bs-toggle="tooltip"
                               data-bs-placement="top"
                               title="View this Time Schedule">

                                <i class="bi bi-eye"></i>
                                View

                            </a>

                            @if (!schedule.IsArchived)
                            {
                                <a asp-controller="TimeSched"
                                   asp-action="EditSchedule"
                                   asp-route-id="@schedule.TimeScheduleId"
                                   class="btn btn-warning btn-sm"
                                   data-bs-toggle="tooltip"
                                   data-bs-placement="top"
                                   title="Create a new version of this Time Schedule">

                                    <i class="bi bi-pencil-square"></i>
                                    Edit
                                </a>

                                <a asp-controller="TimeSched"
                                   asp-action="EditDetails"
                                   asp-route-id="@schedule.TimeScheduleId"
                                   class="btn btn-primary btn-sm"
                                   title="Edit schedule name and description">

                                    <i class="bi bi-pencil"></i>
                                    Edit Details
                                </a>
                            }

                        </td>

                    </tr>

                    count++;
                }
            }
            else
            {
                <tr>

                    <td colspan="6" class="text-muted py-4">

                        No time schedules have been added yet.

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>

@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            var tooltipTriggerList =
                [].slice.call(
                    document.querySelectorAll('[data-bs-toggle="tooltip"]')
                );

            tooltipTriggerList.forEach(function (tooltipTriggerEl) {

                new bootstrap.Tooltip(tooltipTriggerEl);

            });

        });

    </script>

}
