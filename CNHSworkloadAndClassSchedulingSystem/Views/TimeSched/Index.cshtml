@model IEnumerable<CNHSworkloadAndClassSchedulingSystem.Models.Domain.TimeSchedule>

@{
    ViewData["Title"] = "Time Schedule";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2 class="fw-bold">
            Time Schedule Management
        </h2>

        <div class="d-flex gap-2">

            <a asp-controller="TimeSched"
               asp-action="ArchivedSchedule"
               class="btn btn-secondary"
               data-bs-toggle="tooltip"
               data-bs-placement="top"
               title="View archived schedule versions">

                <i class="bi bi-archive"></i>
                Archived Schedules

            </a>

            <a asp-controller="TimeSched"
               asp-action="AddSchedule"
               class="btn btn-primary"
               data-bs-toggle="tooltip"
               data-bs-placement="top"
               title="Add a new Time Schedule">

                <i class="bi bi-plus-circle"></i>
                Add Time Schedule

            </a>

        </div>

    </div>

    <table class="table table-bordered table-hover text-center">

        <thead class="table-dark">

            <tr>
                <th width="60">#</th>
                <th>Schedule Name</th>
                <th width="100">Version</th>
                <th width="130">Number of Periods</th>
                <th width="120">Status</th>
                <th width="320">Actions</th>
            </tr>

        </thead>

        <tbody>

            @{
                int count = 1;
            }

            @if (Model != null && Model.Any(x => !x.IsArchived))
            {
                @foreach (var schedule in Model.Where(x => !x.IsArchived))
                {
                    <tr>

                        <td>@count</td>

                        <td class="fw-semibold">
                            @schedule.ScheduleName
                        </td>

                        <td>
                            Version @schedule.VersionNumber
                        </td>

                        <td>
                            @schedule.TimePeriods.Count
                        </td>

                        <td>

                            <span class="badge bg-success">
                                Available
                            </span>

                        </td>

                        <td style="white-space: nowrap;">

                            <div class="d-flex justify-content-center align-items-center gap-2 flex-nowrap">

                                <a asp-controller="TimeSched"
                                   asp-action="ViewSchedule"
                                   asp-route-id="@schedule.TimeScheduleId"
                                   class="btn btn-info btn-sm"
                                   data-bs-toggle="tooltip"
                                   data-bs-placement="top"
                                   title="View this Time Schedule">

                                    <i class="bi bi-eye"></i>
                                    View

                                </a>

                                <a asp-controller="TimeSched"
                                   asp-action="EditSchedule"
                                   asp-route-id="@schedule.TimeScheduleId"
                                   class="btn btn-warning btn-sm"
                                   data-bs-toggle="tooltip"
                                   data-bs-placement="top"
                                   title="Create a new version of this Time Schedule">

                                    <i class="bi bi-pencil-square"></i>
                                    Edit

                                </a>

                                <a asp-controller="TimeSched"
                                   asp-action="EditDetails"
                                   asp-route-id="@schedule.TimeScheduleId"
                                   class="btn btn-primary btn-sm"
                                   data-bs-toggle="tooltip"
                                   data-bs-placement="top"
                                   title="Edit schedule name and description">

                                    <i class="bi bi-pencil"></i>
                                    Edit Details

                                </a>

                            </div>

                        </td>

                    </tr>

                    count++;
                }
            }
            else
            {
                <tr>

                    <td colspan="6"
                        class="text-muted py-4">

                        No active time schedules have been added yet.

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>

@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            var tooltipTriggerList =
                [].slice.call(
                    document.querySelectorAll('[data-bs-toggle="tooltip"]')
                );

            tooltipTriggerList.forEach(function(tooltipTriggerEl) {

                new bootstrap.Tooltip(tooltipTriggerEl);

            });

        });

    </script>

}